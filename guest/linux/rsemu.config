# rsemu guest kernel: fast startup, containers, virtio-only devices.
# Applied on top of riscv defconfig (linux 7.0.11).

## Startup speed
# CONFIG_LEGACY_PTYS is not set
CONFIG_RISCV_EFFICIENT_UNALIGNED_ACCESS=y
CONFIG_RISCV_EFFICIENT_VECTOR_UNALIGNED_ACCESS=y
CONFIG_BLK_DEV_LOOP=y
CONFIG_BLK_DEV_LOOP_MIN_COUNT=0
CONFIG_SERIAL_8250_NR_UARTS=2
CONFIG_SERIAL_8250_RUNTIME_UARTS=2
CONFIG_NR_CPUS=8
# CONFIG_DEBUG_MISC is not set
# CONFIG_DEBUG_MEMORY_INIT is not set
# CONFIG_SLUB_DEBUG is not set
# CONFIG_KEXEC is not set
# CONFIG_KEXEC_FILE is not set
# CONFIG_CRASH_DUMP is not set
# CONFIG_HIBERNATION is not set
# CONFIG_SUSPEND is not set
# CONFIG_CPU_IDLE is not set
# CONFIG_CPU_FREQ is not set
# CONFIG_EFI is not set
# CONFIG_ACPI is not set

# Built in (instead of modules) these cost seconds at boot: jitterentropy
# self-test 1.3 s, raid6/xor benchmarks for btrfs 0.65 s.
# CONFIG_BTRFS_FS is not set
# CONFIG_CRYPTO_JITTERENTROPY is not set
# CONFIG_CRYPTO_DRBG_MENU is not set
# CONFIG_INET_ESP is not set
# CONFIG_XFRM_USER is not set
# CONFIG_BLK_DEV_DM is not set
# CONFIG_KVM is not set
# CONFIG_CRYPTO_DEV_VIRTIO is not set

## Hardware: only the emulator's platform devices and virtio
# CONFIG_ARCH_ANDES is not set
# CONFIG_ARCH_ANLOGIC is not set
# CONFIG_ARCH_MICROCHIP is not set
# CONFIG_ARCH_MICROCHIP_POLARFIRE is not set
# CONFIG_ARCH_SIFIVE is not set
# CONFIG_ARCH_SOPHGO is not set
# CONFIG_ARCH_SPACEMIT is not set
# CONFIG_ARCH_STARFIVE is not set
# CONFIG_SOC_STARFIVE is not set
# CONFIG_ARCH_SUNXI is not set
# CONFIG_ARCH_TENSTORRENT is not set
# CONFIG_ARCH_THEAD is not set
# CONFIG_ARCH_CANAAN is not set
# CONFIG_ARCH_RENESAS is not set
CONFIG_ARCH_VIRT=y
# CONFIG_PCI is not set
# CONFIG_USB_SUPPORT is not set
# CONFIG_SOUND is not set
# CONFIG_MMC is not set
# CONFIG_SCSI is not set
# CONFIG_ATA is not set
# CONFIG_MTD is not set
# CONFIG_SPI is not set
# I2C core stays: DRM selects it.
# CONFIG_I2C_CHARDEV is not set
# CONFIG_PWM is not set
# CONFIG_IIO is not set
# CONFIG_MEDIA_SUPPORT is not set
# CONFIG_RPMSG_VIRTIO is not set
# CONFIG_RPMSG is not set
# CONFIG_REMOTEPROC is not set
# CONFIG_DMADEVICES is not set
# CONFIG_WATCHDOG is not set
# CONFIG_THERMAL is not set
# CONFIG_HWMON is not set
# CONFIG_POWER_SUPPLY is not set
# CONFIG_REGULATOR is not set
# CONFIG_NEW_LEDS is not set
# CONFIG_SERIO is not set
# CONFIG_INPUT_KEYBOARD is not set
# CONFIG_INPUT_MOUSE is not set
# CONFIG_INPUT_MOUSEDEV is not set
# CONFIG_HID is not set
# CONFIG_ETHERNET is not set
# CONFIG_WLAN is not set
# CONFIG_WIRELESS is not set
# CONFIG_BT is not set
# CONFIG_CAN is not set
# CONFIG_NFC is not set
# CONFIG_MAILBOX is not set
# CONFIG_GENERIC_PHY is not set
# CONFIG_DRM_RADEON is not set
# CONFIG_DRM_NOUVEAU is not set
# CONFIG_DRM_AMDGPU is not set
# CONFIG_NFS_FS is not set
# CONFIG_NFSD is not set
# CONFIG_9P_FS is not set
# CONFIG_NET_9P is not set
CONFIG_SERIAL_8250=y
CONFIG_SERIAL_8250_CONSOLE=y
CONFIG_SERIAL_OF_PLATFORM=y
CONFIG_SERIAL_EARLYCON_RISCV_SBI=y
CONFIG_RTC_CLASS=y
CONFIG_RTC_DRV_GOLDFISH=y
CONFIG_POWER_RESET=y
CONFIG_POWER_RESET_SYSCON=y
CONFIG_POWER_RESET_SYSCON_POWEROFF=y
CONFIG_SIFIVE_PLIC=y
CONFIG_VIRTIO=y
CONFIG_VIRTIO_MENU=y
CONFIG_VIRTIO_MMIO=y
CONFIG_VIRTIO_BLK=y
CONFIG_VIRTIO_NET=y
CONFIG_VIRTIO_CONSOLE=y
CONFIG_VIRTIO_BALLOON=y
CONFIG_VIRTIO_INPUT=y
CONFIG_VSOCKETS=y
CONFIG_VIRTIO_VSOCKETS=y
# CONFIG_VSOCKETS_DIAG is not set
# CONFIG_VSOCKETS_LOOPBACK is not set
CONFIG_HW_RANDOM=y
CONFIG_HW_RANDOM_VIRTIO=y
CONFIG_DRM=y
CONFIG_DRM_VIRTIO_GPU=y
CONFIG_INPUT=y
CONFIG_INPUT_EVDEV=y

## Filesystems
CONFIG_EXT4_FS=y
CONFIG_EXT4_USE_FOR_EXT2=y
CONFIG_EXT4_FS_POSIX_ACL=y
CONFIG_EXT4_FS_SECURITY=y
CONFIG_TMPFS=y
CONFIG_TMPFS_POSIX_ACL=y
CONFIG_TMPFS_XATTR=y
CONFIG_OVERLAY_FS=y
CONFIG_FUSE_FS=y
CONFIG_SQUASHFS=y
CONFIG_SQUASHFS_XZ=y
CONFIG_SQUASHFS_ZSTD=y

## Containers: namespaces, cgroups, seccomp, BPF
CONFIG_NAMESPACES=y
CONFIG_UTS_NS=y
CONFIG_IPC_NS=y
CONFIG_USER_NS=y
CONFIG_PID_NS=y
CONFIG_NET_NS=y
CONFIG_TIME_NS=y
CONFIG_SYSVIPC=y
CONFIG_POSIX_MQUEUE=y
