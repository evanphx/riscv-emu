riscv: Sort mcount_loc at build time

Without HAVE_BUILDTIME_MCOUNT_SORT, ftrace sorts the ~34000 entries of
__mcount_loc at every boot; with defconfig plus the function tracer
that is about a fifth of the instructions the kernel runs before init,
which an emulated machine notices.

scripts/sorttable already handles riscv ELF files. Its mcount sort
zeroes the entries that are not inside a function from the symbol
table (overridden weak functions), and the patchable function entry
puts 8 bytes of nops before the function on riscv, with or without
RVC, so set before_func as for arm64; otherwise every entry is
dropped. A relocatable kernel fills __mcount_loc in at boot, so only
select it for non-relocatable kernels.

Tested with FTRACE_SORT_STARTUP_TEST ("sorted properly"), the function
tracer, and BPF fentry/fexit programs.

--- a/arch/riscv/Kconfig
+++ b/arch/riscv/Kconfig
@@ -151,6 +151,8 @@
 	select HAVE_ARCH_USERFAULTFD_WP if 64BIT && MMU && USERFAULTFD && RISCV_ISA_SVRSW60T59B
 	select HAVE_ARCH_VMAP_STACK if MMU && 64BIT
 	select HAVE_ASM_MODVERSIONS
+	# A relocatable kernel's __mcount_loc is filled in at boot.
+	select HAVE_BUILDTIME_MCOUNT_SORT if !RELOCATABLE
 	select HAVE_CONTEXT_TRACKING_USER
 	select HAVE_DEBUG_KMEMLEAK
 	select HAVE_DMA_CONTIGUOUS if MMU
--- a/scripts/sorttable.c
+++ b/scripts/sorttable.c
@@ -901,11 +901,17 @@
 		/* fallthrough */
 	case EM_386:
 	case EM_LOONGARCH:
-	case EM_RISCV:
 	case EM_S390:
 	case EM_X86_64:
 		custom_sort = sort_relative_table_with_data;
 		break;
+	case EM_RISCV:
+#ifdef MCOUNT_SORT_ENABLED
+		/* riscv places 8 bytes of patchable function entry before the function */
+		before_func = 8;
+#endif
+		custom_sort = sort_relative_table_with_data;
+		break;
 	case EM_PARISC:
 	case EM_PPC:
 	case EM_PPC64:
