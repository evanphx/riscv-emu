+/*
+ * Relative jump labels (64-bit): sort __jump_table as
+ * jump_label_sort_entries() does, by key and then by code address, so
+ * that the kernel finds it sorted at boot.
+ */
+static bool sort_jump_table_rel;
+
+struct jump_ent {
+	uint64_t key;
+	uint64_t code;
+	uint64_t target;
+	uint64_t flags;
+};
+
+static int cmp_jump_ent(const void *a, const void *b)
+{
+	const struct jump_ent *x = a, *y = b;
+
+	if (x->key != y->key)
+		return x->key < y->key ? -1 : 1;
+	if (x->code != y->code)
+		return x->code < y->code ? -1 : 1;
+	return 0;
+}
+
+static int sort_jump_table(Elf_Ehdr *ehdr, Elf_Shdr *symtab_sec,
+			   const char *strtab, char const *const fname)
+{
+	Elf_Shdr *shdr_start = (Elf_Shdr *)((char *)ehdr + ehdr_shoff(ehdr));
+	int shentsize = ehdr_shentsize(ehdr);
+	int symentsize = shdr_entsize(symtab_sec);
+	uint64_t start = 0, stop = 0, n, i;
+	unsigned int shnum = ehdr_shnum(ehdr);
+	Elf_Sym *sym, *end_sym;
+	struct jump_ent *ents;
+	Elf_Shdr *sec = NULL;
+	char *image;
+
+	sym = (void *)ehdr + shdr_offset(symtab_sec);
+	end_sym = (void *)sym + shdr_size(symtab_sec);
+	for (; sym < end_sym; sym = (void *)sym + symentsize) {
+		if (!strcmp(strtab + sym_name(sym), "__start___jump_table"))
+			start = sym_value(sym);
+		else if (!strcmp(strtab + sym_name(sym), "__stop___jump_table"))
+			stop = sym_value(sym);
+	}
+	if (!start || !stop || start == stop)
+		return 0;
+
+	if (shnum == SHN_UNDEF)
+		shnum = shdr_size(shdr_start);
+	for (i = 0; i < shnum; i++) {
+		Elf_Shdr *shdr = get_index(shdr_start, shentsize, i);
+
+		if (shdr_type(shdr) != SHT_NOBITS && shdr_addr(shdr) <= start &&
+		    stop <= shdr_addr(shdr) + shdr_size(shdr)) {
+			sec = shdr;
+			break;
+		}
+	}
+	if (!sec || (stop - start) % 16) {
+		fprintf(stderr, "bad __jump_table in file: %s\n", fname);
+		return -1;
+	}
+
+	image = (char *)ehdr + shdr_offset(sec) + (start - shdr_addr(sec));
+	n = (stop - start) / 16;
+	ents = malloc(n * sizeof(*ents));
+	if (!ents)
+		return -1;
+	for (i = 0; i < n; i++) {
+		char *e = image + i * 16;
+		uint64_t addr = start + i * 16;
+		int64_t key = elf_parser.r8((uint64_t *)(e + 8));
+
+		ents[i].code = addr + (int32_t)elf_parser.r((uint32_t *)e);
+		ents[i].target = addr + 4 + (int32_t)elf_parser.r((uint32_t *)(e + 4));
+		ents[i].key = addr + 8 + (key & ~3LL);
+		ents[i].flags = key & 3;
+	}
+	qsort(ents, n, sizeof(*ents), cmp_jump_ent);
+	for (i = 0; i < n; i++) {
+		char *e = image + i * 16;
+		uint64_t addr = start + i * 16;
+
+		elf_parser.w(ents[i].code - addr, (uint32_t *)e);
+		elf_parser.w(ents[i].target - (addr + 4), (uint32_t *)(e + 4));
+		elf_parser.w8((ents[i].key - (addr + 8)) | ents[i].flags, (uint64_t *)(e + 8));
+	}
+	free(ents);
+	return 0;
+}
+
 static int do_sort(Elf_Ehdr *ehdr,
 		   char const *const fname,
 		   table_sort_t custom_sort)
