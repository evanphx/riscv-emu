{
  "bios":    "opensbi/fw_jump.bin",
  "kernel":  "linux-7.0.11-rsemu/Image",
  "symbols": "linux-7.0.11-rsemu/System.map",
  "initrd":  "vmagent/vmagent.cpio",
  "novector": true,
  "append":  "earlycon=sbi console=ttyS0,115200 quiet vmagent.init=none",
  "memory":  "2G",
  "drives": [
    {
      "id":     "hd0",
      "format": "raw",
      "file":   "rootfs/node.ext4",
      "readonly": true
    }
  ],
  "devices": [
    {
      "type":  "virtio-blk-device",
      "drive": "hd0"
    }
  ]
}
